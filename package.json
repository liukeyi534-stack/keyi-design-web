{
  "name": "lowkey-archive-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:public": "node scripts/check-public.mjs",
    "ci": "npm run validate:content && npm run typecheck && npm run lint && npm run build && npm run check:public"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "gsap": "3.12.5",
    "next": "15.5.24",
    "photoswipe": "^5.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.169.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.24",
    "sharp": "^0.35.4",
    "typescript": "5.5.4"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28"
